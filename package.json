{
  "name": "desksuite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/build-lore-bridge.mjs --if-missing && electron-vite dev",
    "build:lore-bridge": "node scripts/build-lore-bridge.mjs --release",
    "build:lore-bridge:debug": "node scripts/build-lore-bridge.mjs",
    "build": "npm run build:lore-bridge && electron-vite build",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
    "package:win": "npm run build && electron-builder --win nsis --config electron-builder.config.cjs --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/guard.mjs",
    "verify:launch": "node scripts/verify/launch.mjs",
    "verify:stop": "node scripts/verify/stop.mjs",
    "verify:smoke": "node scripts/verify/mcp.mjs smoke",
    "verify:shot": "node scripts/verify/capture.mjs",
    "verify:errors": "node scripts/verify/errors.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@leafer-in/arrow": "2.3.2",
    "@leafer-in/editor": "2.3.2",
    "@leafer-in/export": "2.3.2",
    "@leafer-in/text-editor": "2.3.2",
    "@leafer-in/view": "2.3.2",
    "@leafer-in/viewport": "2.3.2",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "6.0.0",
    "cmdk": "1.1.1",
    "cordis": "^4.0.0-rc.12",
    "dompurify": "3.4.17",
    "electron-updater": "6.8.11",
    "leafer-ui": "2.3.2",
    "leafer-x-clip-resize-inner-editor": "^1.10.0",
    "leafer-x-easy-snap": "1.11.0",
    "leafer-x-ruler": "2.0.1",
    "lucide-react": "^1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@40.10.6": true
  }
}
